# Reps environment. Copy to .env.local (gitignored). Never commit real keys.

# ── Supabase: the EXISTING stefenewers.com project (no separate Reps project) ──
# Same project URL the personal site uses.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Browser key: Settings > API Keys > "Publishable key" (sb_publishable_...).
# A legacy anon key also works via NEXT_PUBLIC_SUPABASE_ANON_KEY.
# Never put a secret / service-role key here: Reps does not need one.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Adaptive coach (server-only) ──
OPENAI_API_KEY=
# Cheap/fast model: micro reps, simple hints, mistake classification.
OPENAI_DEFAULT_MODEL=gpt-5-mini
# Stronger model: hard diagnosis, interview review, hard generations.
OPENAI_REASONING_MODEL=gpt-5

# Optional. In production the coach routes require a signed-in Reps owner.
# For local development without Supabase sign-in, set this to 1.
REPS_ALLOW_UNAUTHENTICATED_AI=
